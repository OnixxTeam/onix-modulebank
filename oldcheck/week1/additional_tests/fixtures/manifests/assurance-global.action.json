    "type": "object",
    "additionalProperties": false,
    "required": ["value"],
    "properties": {"value": {"type": "string", "minLength": 1, "maxLength": 64}}
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["value", "revision"],
    "properties": {"value": {"type": "string"}, "revision": {"const": "scope"}}
  },
  "outcomes": ["ACCEPTED"],
  "required_policy": ["assurance:execute"],
  "idempotency_mode": "required",
