<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Explicit, namespaced entry point (Workflow.Worker.WorkerHost): the
         generated global `Program` of a second ASP.NET project in this solution
         would collide with Course.Api's in the test assembly that references
         both. See the comment on WorkerHost. -->
    <StartupObject>Workflow.Worker.WorkerHost</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Course.Core\Course.Core.csproj" />
    <ProjectReference Include="..\Course.Infrastructure\Course.Infrastructure.csproj" />
    <ProjectReference Include="..\Course.Observability\Course.Observability.csproj" />
    <ProjectReference Include="..\Workflow.Core\Workflow.Core.csproj" />
  </ItemGroup>

</Project>
