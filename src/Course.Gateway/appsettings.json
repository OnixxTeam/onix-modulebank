{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "actions": {
        "ClusterId": "api",
        "Match": { "Path": "/api/{module}/{action}", "Methods": ["POST"] }
      },
      "openapi-default": {
        "ClusterId": "api",
        "Match": { "Path": "/openapi/default.json", "Methods": ["GET"] }
      },
      "openapi-version": {
        "ClusterId": "api",
        "Match": {
          "Path": "/openapi/actions/{module}/{action}/{version}.json",
          "Methods": ["GET"]
        }
      },
      "ready": {
        "ClusterId": "api",
        "Match": { "Path": "/health/ready", "Methods": ["GET"] }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "primary": { "Address": "http://api:8080/" }
        }
      }
    }
  }
}
