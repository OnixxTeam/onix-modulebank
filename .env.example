# Dev-only placeholders. Never real secrets.
# Скопируйте в `.env`: cp .env.example .env
#
# Файл обслуживает два разных сценария, они не пересекаются:
#   1. Compose-интерполяция — блок ниже, `${VAR:-default}` в compose.yaml.
#   2. Локальный запуск без Docker — `make start_local_*` делает
#      `set -a && . ./.env`, поэтому переменные попадают прямо в процесс.
# Переменные из блока 2 в compose не интерполируются: значения для
# контейнеров заданы в compose.yaml литералами, так что `Host=localhost`
# ниже никак не влияет на `docker compose up`.

# --- 1. Compose: подставляется в compose.yaml -------------------------------

# PostgreSQL superuser password used by the postgres image itself.
POSTGRES_PASSWORD=postgres

# Application role passwords, consumed by db/init/00-roles.sh via psql -v.
COURSE_MIGRATOR_PASSWORD=migrator
COURSE_PUBLISHER_PASSWORD=publisher
COURSE_RUNTIME_PASSWORD=runtime

# HS256 key for JWT verification in `api`. Must be at least 32 bytes.
# autocheck подменяет его своим значением через Compose override.
COURSE_JWT_SIGNING_KEY=dev-insecure-key-not-for-production-32

# --- 2. Локальный запуск: make start_local_api / start_local_cli ------------

# Course.Api требует четыре переменные и падает на первой пустой
# (RequireEnv, src/Course.Api/Program.cs): эти три плюс COURSE_JWT_SIGNING_KEY
# из блока 1.
COURSE_JWT_ISSUER=moduledev-course
COURSE_JWT_AUDIENCE=moduledev-api
# Кавычки обязательны: `make start_local_api` делает `. ./.env`, и без них
# bash разорвёт значение по `;` на отдельные присваивания.
COURSE_RUNTIME_DSN="Host=localhost;Port=5432;Database=course;Username=course_runtime;Password=runtime"

# Course.Cli строит строку подключения из этих трёх плюс пароля нужной роли
# (course_migrator для `migration apply`, course_publisher для команд `action`).
# `make start_local_cli` и так перекрывает COURSE_DB_HOST на localhost, значение
# ниже нужно для прямого `dotnet run --project src/Course.Cli`.
COURSE_DB_HOST=localhost
COURSE_DB_PORT=5432
COURSE_DB_NAME=course
