# Dev-only placeholders. Never real secrets.
# Скопируйте в `.env`: cp .env.example .env
#
# Файл обслуживает два разных сценария, они не пересекаются:
#   1. Compose-интерполяция — блок ниже, `${VAR:-default}` в compose.yaml.
#   2. Локальный запуск без Docker — `make start_local_*` делает
#      `set -a && . ./.env`, поэтому переменные попадают прямо в процесс.
# Переменные из блока 2 в compose не интерполируются: значения для
# контейнеров заданы в compose.yaml литералами, так что `Host=localhost`
# ниже никак не влияет на `docker compose up`.

# --- 1. Compose: подставляется в compose.yaml -------------------------------

# PostgreSQL superuser password used by the postgres image itself.
POSTGRES_PASSWORD=postgres

# Application role passwords, consumed by db/init/00-roles.sh via psql -v.
COURSE_MIGRATOR_PASSWORD=migrator
COURSE_PUBLISHER_PASSWORD=publisher
COURSE_RUNTIME_PASSWORD=runtime
WORKFLOW_WORKER_PASSWORD=worker
COURSE_OUTBOX_PASSWORD=outbox
COURSE_INBOX_PASSWORD=inbox

# HS256 key for JWT verification in `api`. Must be at least 32 bytes.
# autocheck подменяет его своим значением через Compose override.
COURSE_JWT_SIGNING_KEY=dev-insecure-key-not-for-production-32

# HMAC key for the generic signature boundary in `api` (ticket 07). Exact
# name fixed by the checker; exact UTF-8 bytes are the key, no trim/decode.
# autocheck подменяет его своим значением через Compose override.
PROVIDER_HMAC_SECRET=dev-insecure-hmac-secret-not-for-production

# Scopes granted to the trusted workflow-worker principal (no JWT: the worker
# builds its own context). `flow validate`/`flow publish` check a map task's
# required_policy against this set; Workflow.Worker will stamp the same value
# onto the context it builds for itself. Space-separated, same shape as a JWT
# "scope" claim. Optional -- Workflow.Core.Security.WorkflowWorkerPrincipal
# defaults to "workflow:execute workflow:read payment:internal" when unset;
# payment:internal is required by every automatic step of both payment maps.
WORKFLOW_WORKER_SCOPES="workflow:execute workflow:read payment:internal"

# outbox-dispatcher (ticket 11). PROVIDER_URL and OUTBOX_OWNER names and their
# local-dev defaults are fixed by the checker's own contract
# (docs/week3/configuration.md).
PROVIDER_URL=http://provider-simulator:8081
OUTBOX_OWNER=outbox-dispatcher

# receipt-adapter (ticket 12). Unlike PROVIDER_URL/OUTBOX_OWNER above,
# PROVIDER_CALLBACK_CAPABILITY and PROVIDER_CALLBACK_TOKEN carry NO default in
# compose.yaml itself (configuration.md: "Default в tracked Compose: Нет") --
# their local-dev values live only here, in the untracked `.env` a developer
# copies this file into. PROVIDER_CALLBACK_TOKEN below is a long-lived
# HS256 JWT (sub=receipt-provider, consumer=receipt-adapter,
# scope=receipt:write) signed with this same file's COURSE_JWT_SIGNING_KEY/
# COURSE_JWT_ISSUER/COURSE_JWT_AUDIENCE placeholders above -- not a real
# secret, just enough for a local `docker compose up` to exercise the real
# path end to end without the checker; regenerate if those three literals
# ever change. RECEIPT_API_URL's default in compose.yaml is the gateway
# service URL, same convention as PROVIDER_URL (table allows a default there).
PROVIDER_CALLBACK_CAPABILITY=local-dev-capability
PROVIDER_CALLBACK_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJtb2R1bGVkZXYtY291cnNlIiwiYXVkIjoibW9kdWxlZGV2LWFwaSIsImlhdCI6MTc4ODcxODM0NCwiZXhwIjoyMTA0MDc4MzQ0LCJzdWIiOiJyZWNlaXB0LXByb3ZpZGVyIiwiY29uc3VtZXIiOiJyZWNlaXB0LWFkYXB0ZXIiLCJzY29wZSI6InJlY2VpcHQ6d3JpdGUifQ.ytO2dqu_kqQNfHNHOtZ-k9mEcb6ZHhZsA5_Sdoq0kos
RECEIPT_API_URL=http://gateway:8080/api/receipt/accept

# --- 2. Локальный запуск: make start_local_api / start_local_cli ------------

# Course.Api требует пять переменных и падает на первой пустой
# (RequireEnv, src/Course.Api/Program.cs): эти две плюс COURSE_JWT_SIGNING_KEY
# и PROVIDER_HMAC_SECRET из блока 1.
COURSE_JWT_ISSUER=moduledev-course
COURSE_JWT_AUDIENCE=moduledev-api
# Кавычки обязательны: `make start_local_api` делает `. ./.env`, и без них
# bash разорвёт значение по `;` на отдельные присваивания.
COURSE_RUNTIME_DSN="Host=localhost;Port=5432;Database=course;Username=course_runtime;Password=runtime"

# Course.Cli строит строку подключения из этих трёх плюс пароля нужной роли
# (course_migrator для `migration apply`, course_publisher для команд `action`).
# `make start_local_cli` и так перекрывает COURSE_DB_HOST на localhost, значение
# ниже нужно для прямого `dotnet run --project src/Course.Cli`.
COURSE_DB_HOST=localhost
COURSE_DB_PORT=5432
COURSE_DB_NAME=course
