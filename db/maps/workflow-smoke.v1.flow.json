{
  "contract_version": "course-1",
  "flow_name": "workflow-smoke",
  "version": 1,
  "start_step": "probe",
  "steps": [
    {
      "key": "probe",
      "type": "automatic",
      "task": {
        "service": "postgres",
        "module": "workflow",
        "action": "probe",
        "action_version": 1,
        "required_policy": ["workflow:execute"],
        "timeout_ms": 5000,
        "retry": {"max_attempts": 1, "delays_ms": []},
        "input_mapping": {},
        "input_constants": {"mode": "SUCCESS", "value": "workflow-smoke-v1"}
      }
    },
    {"key": "wait", "type": "wait_signal", "signal_type": "workflow-smoke.signal", "outcome": "SIGNALED"},
    {"key": "review", "type": "manual", "allowed_outcomes": ["APPROVED"]},
    {"key": "end", "type": "end", "outcome": "DONE_V1"}
  ],
  "transitions": [
    {"from": "probe", "outcome": "SUCCEEDED", "to": "wait"},
    {"from": "probe", "outcome": "ROUTE_MANUAL", "to": "review"},
    {"from": "wait", "outcome": "SIGNALED", "to": "end"},
    {"from": "review", "outcome": "APPROVED", "to": "end"}
  ]
}
