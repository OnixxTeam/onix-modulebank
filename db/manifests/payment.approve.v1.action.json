{
  "contract_version": "course-1",
  "module": "payment",
  "action": "approve",
  "version": 1,
  "http_method": "POST",
  "target_schema": "payment",
  "target_function": "approve_v1",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:course:course-1:payment-approve-payload",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operationId"
    ],
    "properties": {
      "operationId": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:course:course-1:payment-approve-response",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operationId",
      "requestId",
      "operationKind",
      "amount",
      "currency",
      "status"
    ],
    "properties": {
      "operationId": {
        "type": "string",
        "format": "uuid"
      },
      "requestId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "operationKind": {
        "enum": [
          "PAYMENT_EXECUTION",
          "PAYMENT_APPROVAL"
        ]
      },
      "amount": {
        "type": "string",
        "pattern": "^(?:0\\.0[1-9]|0\\.[1-9][0-9]?|[1-9][0-9]{0,15}(?:\\.[0-9]{1,2})?)$"
      },
      "currency": {
        "const": "RUB"
      },
      "status": {
        "enum": [
          "CREATED",
          "PROCESSING",
          "COMPLETED",
          "REJECTED"
        ]
      }
    }
  },
  "outcomes": [
    "APPROVED"
  ],
  "required_policy": [
    "workflow:execute"
  ],
  "idempotency_mode": "required",
  "idempotency_scope": "principal_action",
  "timeout_ms": 5000,
  "enabled": true,
  "is_default": true
}
