{
  "contract_version": "course-1",
  "module": "assurance",
  "action": "execute",
  "version": 1,
  "http_method": "POST",
  "target_schema": "quality_assurance",
  "target_function": "execute_v1",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["mode", "value"],
    "properties": {
      "mode": {"enum": ["ok", "error", "unknown_outcome", "invalid_result", "timeout"]},
      "value": {"type": "string", "minLength": 1, "maxLength": 64}
    }
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["value", "revision", "principal", "consumer", "scopes", "requestId", "correlationId", "deadline"],
    "properties": {
      "value": {"type": "string"},
      "revision": {"const": "v1"},
      "principal": {"type": "string"},
      "consumer": {"type": "string"},
      "scopes": {"type": "array", "items": {"type": "string"}},
      "requestId": {"type": "string"},
      "correlationId": {"type": "string", "format": "uuid"},
      "deadline": {"type": "string", "format": "date-time"}
    }
  },
  "outcomes": ["ACCEPTED"],
  "required_policy": ["assurance:execute", "tenant:read"],
  "idempotency_mode": "required",
  "idempotency_scope": "principal_action",
  "timeout_ms": 250,
  "enabled": true,
  "is_default": true
}
